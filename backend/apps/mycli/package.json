{
  "name": "@cosmos2023/mycli",
  "version": "0.1.1",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "mycli": "dist/cli.js"
  },
  "types": "./dist/cli.d.ts",
  "exports": {
    "./backend": {
      "mycli-source": "./src/backend.ts",
      "types": "./dist/backend.d.ts",
      "import": "./dist/backend.js"
    },
    "./gateway": {
      "mycli-source": "./src/gateway.ts",
      "types": "./dist/gateway.d.ts",
      "import": "./dist/gateway.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-system-prompt.mjs",
    "prepack": "node scripts/vendor-internal-packages.mjs",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\" --test-reporter=dot",
    "test:m5": "node --import tsx --test test/m5-state-recovery.integration.test.ts",
    "test:m6": "node --import tsx --test test/m6-persistent-shell.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@decimalturn/toml-patch": "^3.0.5",
    "@earendil-works/pi-ai": "0.84.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "adm-zip": "^0.6.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.2",
    "cli-highlight": "2.1.11",
    "csv-parse": "^6.1.0",
    "diff": "^9.0.0",
    "eventsource-parser": "3.1.0",
    "get-east-asian-width": "1.6.0",
    "js-tiktoken": "^1.0.21",
    "linebreak": "1.1.0",
    "marked": "15.0.12",
    "node-pty": "1.2.0-beta.15",
    "parse-diff": "0.12.0",
    "parse5": "^7.3.0",
    "sharp": "^0.35.4",
    "shell-quote": "1.10.0",
    "smol-toml": "^1.7.1",
    "tar": "^7.5.22",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "@cosmos2023/ripgrep-darwin-arm64": "0.1.1",
    "@cosmos2023/ripgrep-darwin-x64": "0.1.1",
    "@cosmos2023/ripgrep-linux-arm64": "0.1.1",
    "@cosmos2023/ripgrep-linux-x64": "0.1.1",
    "@cosmos2023/ripgrep-win32-arm64": "0.1.1",
    "@cosmos2023/ripgrep-win32-x64": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
