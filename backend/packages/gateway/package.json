      "import": "./dist/flow-control/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\" --test-reporter=dot",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "@mycli/contracts": "0.1.0" },
  "engines": { "node": ">=22.19.0" }
}
