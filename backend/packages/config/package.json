{
  "name": "@mycli/config",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "mycli-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./profile": {
      "mycli-source": "./src/configuration/config-profile.ts",
      "types": "./dist/configuration/config-profile.d.ts",
      "import": "./dist/configuration/config-profile.js"
    },
    "./paths": {
      "mycli-source": "./src/configuration/config-paths.ts",
      "types": "./dist/configuration/config-paths.d.ts",
      "import": "./dist/configuration/config-paths.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\" --test-reporter=dot",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@decimalturn/toml-patch": "^3.0.5",
    "@mycli/contracts": "0.1.1",
    "@mycli/core": "0.1.1",
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
