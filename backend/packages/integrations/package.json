{
  "name": "@mycli/integrations",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets"
  ],
 "exports": {
  ".": {
   "mycli-source": "./src/index.ts",
   "types": "./dist/index.d.ts",
