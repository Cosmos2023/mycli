    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mycli/config": "0.1.1",
    "@mycli/contracts": "0.1.1",
    "@mycli/core": "0.1.1",
    "@mycli/storage": "0.1.1",
    "@mycli/tools": "0.1.1",
    "smol-toml": "^1.7.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
