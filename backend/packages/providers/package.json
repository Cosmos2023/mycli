{
  "name": "@mycli/providers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "mycli-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\" --test-reporter=dot",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
		"@earendil-works/pi-ai": "0.84.4",
		"@mycli/config": "0.1.0",
		"@mycli/contracts": "0.1.0",
		"@mycli/core": "0.1.0",
		"eventsource-parser": "3.1.0"
	},
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
