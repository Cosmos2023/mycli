{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycli.local/contracts/session-goal.schema.json",
  "title": "SessionGoal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal_id",
    "revision",
    "objective",
    "status",
    "token_budget",
    "tokens_used",
    "elapsed_ms",
    "rounds_started",
    "audit_turns",
    "created_at",
    "updated_at",
    "stop_reason",
    "usage_incomplete"
  ],
  "properties": {
    "goal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "blocked",
        "usage_limited",
        "budget_limited",
        "complete"
      ]
    },
    "token_budget": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "tokens_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rounds_started": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "audit_turns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "usage_incomplete": {
      "type": "boolean"
    }
  }
}
