{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycli.local/contracts/plugin-v2-protocol.schema.json",
  "title": "PluginV2ProtocolMessage",
  "oneOf": [
    {"$ref": "#/$defs/initialize"},
    {"$ref": "#/$defs/registered"},
    {"$ref": "#/$defs/invoke"},
    {"$ref": "#/$defs/result"},
    {"$ref": "#/$defs/error"},
    {"$ref": "#/$defs/shutdown"},
    {"$ref": "#/$defs/shutdown_complete"}
  ],
  "$defs": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$"
    },
    "plugin_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "declaration_name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "tool_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^tool:[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "hook_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^hook:[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "command_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^command:[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "hook_point": {
      "type": "string",
      "enum": [
        "pre_tool_use",
        "post_tool_use",
        "user_prompt_submit",
        "stop",
        "pre_compact",
        "session_start",
        "session_end"
      ]
    },
    "declarations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "hooks", "commands"],
      "properties": {
        "tools": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/declaration_name"}
        },
        "hooks": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/hook_point"}
        },
        "commands": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/declaration_name"}
        }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "filesystem_read",
          "filesystem_write",
          "network",
          "process_spawn"
        ]
      }
    },
    "environment_names": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
      }
    },
    "input_schema": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "properties"],
      "properties": {
        "type": {"const": "object"},
        "properties": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {"type": "object"}
        },
        "required": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 64}
        },
        "additionalProperties": {"type": "boolean"}
      }
    },
    "tool_registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "token", "name", "description", "input_schema"],
      "properties": {
        "kind": {"const": "tool"},
        "token": {"$ref": "#/$defs/tool_token"},
        "name": {"$ref": "#/$defs/declaration_name"},
        "description": {"type": "string", "maxLength": 512},
        "input_schema": {"$ref": "#/$defs/input_schema"}
      }
    },
    "hook_registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "token", "name", "hook_point", "input_schema"],
      "properties": {
        "kind": {"const": "hook"},
        "token": {"$ref": "#/$defs/hook_token"},
        "name": {"$ref": "#/$defs/declaration_name"},
        "hook_point": {"$ref": "#/$defs/hook_point"},
        "input_schema": {"$ref": "#/$defs/input_schema"}
      }
    },
    "command_registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "token", "name", "description", "input_schema"],
      "properties": {
        "kind": {"const": "command"},
        "token": {"$ref": "#/$defs/command_token"},
        "name": {"$ref": "#/$defs/declaration_name"},
        "description": {"type": "string", "maxLength": 512},
        "input_schema": {"$ref": "#/$defs/input_schema"}
      }
    },
    "registration": {
      "oneOf": [
        {"$ref": "#/$defs/tool_registration"},
        {"$ref": "#/$defs/hook_registration"},
        {"$ref": "#/$defs/command_registration"}
      ]
    },
    "initialize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "request_id",
        "plugin_id",
        "declared",
        "capabilities",
        "requires_env"
      ],
      "properties": {
        "version": {"const": 2},
        "type": {"const": "initialize"},
        "request_id": {"$ref": "#/$defs/request_id"},
        "plugin_id": {"$ref": "#/$defs/plugin_id"},
        "declared": {"$ref": "#/$defs/declarations"},
        "capabilities": {"$ref": "#/$defs/capabilities"},
        "requires_env": {"$ref": "#/$defs/environment_names"}
      }
    },
    "registered": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "request_id", "registrations"],
      "properties": {
        "version": {"const": 2},
        "type": {"const": "registered"},
        "request_id": {"$ref": "#/$defs/request_id"},
        "registrations": {
          "type": "array",
          "maxItems": 192,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/registration"}
        }
      }
    },
    "invoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "request_id", "target", "input"],
      "properties": {
        "version": {"const": 2},
        "type": {"const": "invoke"},
        "request_id": {"$ref": "#/$defs/request_id"},
        "target": {
          "oneOf": [
            {"$ref": "#/$defs/tool_token"},
            {"$ref": "#/$defs/hook_token"},
            {"$ref": "#/$defs/command_token"}
          ]
        },
        "input": {"type": "object", "maxProperties": 64}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "request_id", "value"],
      "properties": {
        "version": {"const": 2},
        "type": {"const": "result"},
        "request_id": {"$ref": "#/$defs/request_id"},
        "value": {}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "request_id", "error"],
      "properties": {
        "version": {"const": 2},
        "type": {"const": "error"},
        "request_id": {"$ref": "#/$defs/request_id"},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "message": {"type": "string", "maxLength": 512}
          }
        }
      }
    },
    "shutdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "request_id"],
      "properties": {
        "version": {"const": 2},
        "type": {"const": "shutdown"},
        "request_id": {"$ref": "#/$defs/request_id"}
      }
    },
    "shutdown_complete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "request_id"],
      "properties": {
        "version": {"const": 2},
        "type": {"const": "shutdown_complete"},
        "request_id": {"$ref": "#/$defs/request_id"}
      }
    }
  }
}
