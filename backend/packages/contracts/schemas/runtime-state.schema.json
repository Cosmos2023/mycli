{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycli.local/schemas/runtime-state.schema.json",
  "title": "RuntimeStateRecord",
  "oneOf": [
    {"$ref": "#/$defs/input_queue"},
    {"$ref": "#/$defs/pending_decision"},
    {"$ref": "#/$defs/suspended_turn"},
    {"$ref": "#/$defs/effect_checkpoint"},
    {"$ref": "#/$defs/compact_checkpoint"},
    {"$ref": "#/$defs/responses_continuation"}
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "bounded_string": {
      "type": "string",
      "maxLength": 65536
    },
    "short_string": {
      "type": "string",
      "maxLength": 4096
    },
    "nullable_identifier": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 256
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "arguments", "reason", "call_id"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "arguments": {"type": "object"},
        "reason": {"$ref": "#/$defs/short_string"},
        "call_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "queued_input": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "queue_id",
        "session_id",
        "client_turn_id",
        "target_turn_id",
        "kind",
        "state",
        "text",
        "image_paths",
        "source",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "queue_id": {"$ref": "#/$defs/identifier"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "client_turn_id": {"$ref": "#/$defs/identifier"},
        "target_turn_id": {"$ref": "#/$defs/nullable_identifier"},
        "kind": {
          "type": "string",
          "enum": ["pending_steer", "rejected_steer", "follow_up"]
        },
        "state": {
          "type": "string",
          "enum": ["queued", "accepted", "claimed", "committed"]
        },
        "claim_turn_id": {"$ref": "#/$defs/nullable_identifier"},
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "image_paths": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "source": {"$ref": "#/$defs/identifier"},
        "created_at": {"$ref": "#/$defs/identifier"},
        "updated_at": {"$ref": "#/$defs/identifier"}
      }
    },
    "input_queue_payload": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "session_id",
        "revision",
        "pending_steers",
        "rejected_steers",
        "follow_ups"
      ],
      "properties": {
        "session_id": {"$ref": "#/$defs/identifier"},
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pending_steers": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "allOf": [
              {"$ref": "#/$defs/queued_input"},
              {"type": "object", "properties": {"kind": {"const": "pending_steer"}}}
            ]
          }
        },
        "rejected_steers": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "allOf": [
              {"$ref": "#/$defs/queued_input"},
              {"type": "object", "properties": {"kind": {"const": "rejected_steer"}}}
            ]
          }
        },
        "follow_ups": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "allOf": [
              {"$ref": "#/$defs/queued_input"},
              {"type": "object", "properties": {"kind": {"const": "follow_up"}}}
            ]
          }
        }
      }
    },
    "input_queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "payload"],
      "properties": {
        "kind": {"const": "input_queue"},
        "version": {"const": 1},
        "payload": {"$ref": "#/$defs/input_queue_payload"}
      }
    },
    "pending_decision_payload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["tool_call", "kind", "reason", "preview", "options"],
      "properties": {
        "tool_call": {"$ref": "#/$defs/tool_call"},
        "kind": {
          "type": "string",
          "enum": ["needs_choice", "auto_allow", "deny"]
        },
        "reason": {"$ref": "#/$defs/short_string"},
        "preview": {"$ref": "#/$defs/short_string"},
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["approve_once", "reject", "allow_session", "always_allow"]
          }
        },
        "command_pattern": {
          "type": ["string", "null"],
          "maxLength": 4096
        },
        "proposed_execpolicy_pattern": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {"$ref": "#/$defs/identifier"}
            }
          ]
        },
        "metadata": {"type": "object"}
      }
    },
    "pending_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "payload"],
      "properties": {
        "kind": {"const": "pending_decision"},
        "version": {"const": 1},
        "payload": {"$ref": "#/$defs/pending_decision_payload"}
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": true,
      "required": ["role", "content"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["system", "developer", "user", "assistant", "tool"]
        },
        "content": {"$ref": "#/$defs/bounded_string"},
        "tool_call_id": {"$ref": "#/$defs/nullable_identifier"},
        "response_id": {"$ref": "#/$defs/nullable_identifier"},
        "metadata": {"type": "object"},
        "blocks": {
          "type": "array",
          "maxItems": 512,
          "items": {"type": "object"}
        },
        "tool_calls": {
          "type": "array",
          "maxItems": 128,
          "items": {"type": "object"}
        }
      }
    },
    "pending_approval": {
      "type": "object",
      "additionalProperties": true,
      "required": ["tool_call", "reason", "preview"],
      "properties": {
        "tool_call": {"$ref": "#/$defs/tool_call"},
        "reason": {"$ref": "#/$defs/short_string"},
        "preview": {"$ref": "#/$defs/short_string"},
        "command_pattern": {
          "type": ["string", "null"],
          "maxLength": 4096
        },
        "proposed_execpolicy_pattern": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {"$ref": "#/$defs/identifier"}
            }
          ]
        },
        "metadata": {"type": "object"}
      }
    },
    "pending_clarification": {
      "type": "object",
      "additionalProperties": true,
      "required": ["request_id", "tool_call", "question", "options", "multi_select"],
      "properties": {
        "request_id": {"$ref": "#/$defs/identifier"},
        "tool_call": {"$ref": "#/$defs/tool_call"},
        "question": {"$ref": "#/$defs/short_string"},
        "options": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "object"}
        },
        "header": {"$ref": "#/$defs/short_string"},
        "multi_select": {"type": "boolean"}
      }
    },
    "suspended_turn_payload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["user_message", "conversation"],
      "properties": {
        "user_message": {"$ref": "#/$defs/bounded_string"},
        "conversation": {
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/message"}
        },
        "transcript_event_id": {"$ref": "#/$defs/identifier"},
        "suspend_reason": {
          "type": "string",
          "enum": [
            "assistant_completed",
            "sufficient_evidence",
            "loop_detected",
            "approval_required",
            "approval_rejected",
            "clarification_required",
            "context_window_exceeded",
            "retry_exhausted",
            "transport_failed",
            "auth_failed",
            "rate_limited",
            "interrupted",
            "runtime_error",
            "model_error"
          ]
        },
        "plan_items": {
          "type": "array",
          "maxItems": 256,
          "items": {"type": "object"}
        },
        "pending_approval": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/pending_approval"}
          ]
        },
        "pending_clarification": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/pending_clarification"}
          ]
        },
        "session_id": {"$ref": "#/$defs/identifier"},
        "client_turn_id": {"$ref": "#/$defs/identifier"},
        "turn_id": {"$ref": "#/$defs/identifier"},
        "provider_protocol": {
          "type": "string",
          "enum": ["responses", "chat_completions", "anthropic_messages"]
        },
        "remaining_tool_calls": {
          "type": "array",
          "maxItems": 128,
          "items": {"type": "object"}
        },
        "continuation": {"type": "object"},
        "parallel_batch": {"$ref": "#/$defs/parallel_approval_batch"}
      }
    },
    "canonical_tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callId", "name", "argumentsJson"],
      "properties": {
        "callId": {"$ref": "#/$defs/identifier"},
        "name": {"$ref": "#/$defs/identifier"},
        "argumentsJson": {"type": "string", "maxLength": 1048576}
      }
    },
    "parallel_approval_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call", "execution_call", "sandbox_override_approved"],
      "properties": {
        "call": {"$ref": "#/$defs/canonical_tool_call"},
        "execution_call": {"$ref": "#/$defs/canonical_tool_call"},
        "sandbox_override_approved": {"type": "boolean"},
        "approval": {"$ref": "#/$defs/pending_decision_payload"},
        "choice": {
          "type": "string",
          "enum": ["approve_once", "allow_session", "always_allow", "reject"]
        }
      }
    },
    "parallel_approval_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "revision", "calls"],
      "properties": {
        "batch_id": {"$ref": "#/$defs/identifier"},
        "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "calls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"$ref": "#/$defs/parallel_approval_call"}
        }
      }
    },
    "suspended_turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "payload"],
      "properties": {
        "kind": {"const": "suspended_turn"},
        "version": {"const": 1},
        "payload": {"$ref": "#/$defs/suspended_turn_payload"}
      }
    },
    "effect_checkpoint_payload": {
      "oneOf": [
        {"$ref": "#/$defs/effect_waiting"},
        {"$ref": "#/$defs/effect_rejected"},
        {"$ref": "#/$defs/effect_approved"},
        {"$ref": "#/$defs/effect_executing"},
        {"$ref": "#/$defs/effect_completed"}
      ]
    },
    "effect_base_properties": {
      "type": "object",
      "required": [
        "session_id",
        "client_turn_id",
        "turn_id",
        "decision_id",
        "call_id",
        "tool_name",
        "status",
        "updated_at"
      ],
      "properties": {
        "session_id": {"$ref": "#/$defs/identifier"},
        "client_turn_id": {"$ref": "#/$defs/identifier"},
        "turn_id": {"$ref": "#/$defs/identifier"},
        "decision_id": {"$ref": "#/$defs/identifier"},
        "call_id": {"$ref": "#/$defs/identifier"},
        "tool_name": {"$ref": "#/$defs/identifier"},
        "status": {
          "type": "string",
          "enum": ["waiting", "rejected", "approved", "executing", "completed"]
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "result_call_id": {"$ref": "#/$defs/identifier"},
        "updated_at": {"$ref": "#/$defs/identifier"}
      }
    },
    "effect_waiting": {
      "allOf": [
        {"$ref": "#/$defs/effect_base_properties"},
        {"type": "object", "properties": {"status": {"const": "waiting"}}}
      ]
    },
    "effect_rejected": {
      "allOf": [
        {"$ref": "#/$defs/effect_base_properties"},
        {"type": "object", "properties": {"status": {"const": "rejected"}}}
      ]
    },
    "effect_approved": {
      "allOf": [
        {"$ref": "#/$defs/effect_base_properties"},
        {"type": "object", "properties": {"status": {"const": "approved"}}}
      ]
    },
    "effect_executing": {
      "allOf": [
        {"$ref": "#/$defs/effect_base_properties"},
        {
          "type": "object",
          "required": ["fingerprint"],
          "properties": {"status": {"const": "executing"}}
        }
      ]
    },
    "effect_completed": {
      "allOf": [
        {"$ref": "#/$defs/effect_base_properties"},
        {
          "type": "object",
          "required": ["fingerprint", "result_call_id"],
          "properties": {"status": {"const": "completed"}}
        }
      ]
    },
    "effect_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "payload"],
      "properties": {
        "kind": {"const": "effect_checkpoint"},
        "version": {"const": 1},
        "payload": {"$ref": "#/$defs/effect_checkpoint_payload"}
      }
    },
    "compact_checkpoint_payload": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "version",
        "turn_id",
        "reason",
        "phase",
        "window_number",
        "window_id",
        "history_item_count",
        "input_history_hash",
        "replacement_history_hash"
      ],
      "properties": {
        "version": {"const": 1},
        "turn_id": {"$ref": "#/$defs/identifier"},
        "reason": {"$ref": "#/$defs/short_string"},
        "phase": {"$ref": "#/$defs/identifier"},
        "window_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "window_id": {"$ref": "#/$defs/identifier"},
        "history_item_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input_history_hash": {"$ref": "#/$defs/identifier"},
        "replacement_history_hash": {"$ref": "#/$defs/identifier"},
        "transcript_event_id": {"$ref": "#/$defs/identifier"},
        "replacement_messages": {
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/message"}
        }
      }
    },
    "compact_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "payload"],
      "properties": {
        "kind": {"const": "compact_checkpoint"},
        "version": {"const": 1},
        "payload": {"$ref": "#/$defs/compact_checkpoint_payload"}
      }
    },
    "responses_continuation_payload": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "response_id",
        "request_signature",
        "request_input",
        "response_output",
        "eligible",
        "failure_reason"
      ],
      "properties": {
        "response_id": {"$ref": "#/$defs/nullable_identifier"},
        "request_signature": {"$ref": "#/$defs/short_string"},
        "request_input": {
          "type": "array",
          "maxItems": 4096,
          "items": {"type": "object"}
        },
        "response_output": {
          "type": "array",
          "maxItems": 4096,
          "items": {"type": "object"}
        },
        "eligible": {"type": "boolean"},
        "failure_reason": {
          "type": ["string", "null"],
          "maxLength": 4096
        },
        "session_id": {"$ref": "#/$defs/identifier"},
        "protocol": {"const": "responses"},
        "model": {"$ref": "#/$defs/identifier"},
        "history_boundary": {"$ref": "#/$defs/identifier"}
      }
    },
    "responses_continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "payload"],
      "properties": {
        "kind": {"const": "responses_continuation"},
        "version": {"const": 1},
        "payload": {"$ref": "#/$defs/responses_continuation_payload"}
      }
    }
  }
}
