      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "$ref": "#/$defs/ShellOutputParams"
        },
        "result": {
          "$ref": "#/$defs/ShellOutputPage"
        }
      }
    },
    "shell.stop": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "type": "object",
          "required": [
            "shell_id"
          ],
          "properties": {
            "shell_id": {
              "$ref": "#/$defs/Identity"
            }
          }
        },
        "result": {
          "$ref": "#/$defs/ShellSnapshot"
        }
      }
    },
    "trace.export": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "tail": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "result": {
          "type": "object",
          "required": [
            "session_id",
            "format",
            "rows"
          ],
          "properties": {
            "session_id": {
              "type": "string"
            },
            "format": {
              "const": "jsonl"
            },
            "rows": {
              "$ref": "#/$defs/Strings"
            }
          }
        }
      }
    },
    "shutdown": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "$ref": "#/$defs/EmptyParams"
        },
        "result": {
          "type": "object",
          "required": [
            "ok"
          ],
          "properties": {
            "ok": {
              "const": true
            }
          }
        }
      }
    }
  },
  "$defs": {
    "Identity": {
      "type": "string",
      "minLength": 1
    },
    "Strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Objects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "EmptyParams": {
      "type": "object"
    },
    "Permission": {
      "enum": [
        "read-only",
        "workspace",
        "full-access"
      ]
    },
    "Trust": {
      "enum": [
        "trusted",
        "untrusted",
        "unknown"
      ]
    },
    "OwnerParams": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/Identity"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "BootstrapMethod": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "protocol_version": {
              "type": "integer"
            },
            "supported_error_context_versions": {
              "type": "array", "maxItems": 8, "uniqueItems": true,
              "items": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "result": {
          "$ref": "#/$defs/Bootstrap"
        }
      }
    },
    "StatusMethod": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "$ref": "#/$defs/EmptyParams"
        },
        "result": {
          "$ref": "#/$defs/Status"
        }
      }
    },
    "Status": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "turn_running": {
          "type": "boolean"
        },
        "trust": {
          "$ref": "#/$defs/TrustState"
        },
        "permissions": {
          "$ref": "#/$defs/Permissions"
        },
        "pending_decision": {
          "type": "boolean"
        },
        "pending_mcp_elicitation": {"type": "boolean"},
        "pending_clarification": {
          "type": "boolean"
        },
        "suspended_turn": {
          "type": "boolean"
        },
        "has_pending_input": {
          "type": "boolean"
        }
      }
    },
    "Bootstrap": {
      "type": "object",
      "required": [
        "protocol_version",
