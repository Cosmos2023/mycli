            "version"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "result": {
          "$ref": "#/$defs/UpdateResult"
        }
      }
    },
    "command.list": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "$ref": "#/$defs/SurfaceParams"
        },
        "result": {
          "type": "object",
          "required": [
            "commands",
            "routing_names"
          ],
          "properties": {
            "commands": {
              "$ref": "#/$defs/Objects"
            },
            "routing_names": {
              "$ref": "#/$defs/Strings"
            }
          }
        }
      }
    },
    "command.run": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "type": "object",
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "surface": {
              "type": "string"
            }
          }
        },
        "result": {
          "$ref": "#/$defs/CommandResult"
        }
      }
    },
    "completion.slash": {
      "$ref": "#/$defs/CompletionMethod"
    },
    "completion.path": {
      "$ref": "#/$defs/CompletionMethod"
    },
    "resource.list": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "$ref": "#/$defs/EmptyParams"
        },
        "result": {
          "type": "object",
          "required": [
            "resources"
          ],
          "properties": {
            "resources": {
              "$ref": "#/$defs/Objects"
            }
          }
        }
      }
    },
    "extension.manifest": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "$ref": "#/$defs/EmptyParams"
        },
        "result": {
          "type": "object",
          "properties": {
            "protocol_version": {
              "type": "integer"
            },
            "tools": {
              "$ref": "#/$defs/Objects"
            },
            "version": {
              "type": "integer"
            }
          }
        }
      }
    },
    "shell.list": {
      "$ref": "#/$defs/ShellListMethod"
    },
    "shell.stop_all": {
      "$ref": "#/$defs/ShellListMethod"
    },
