            }
          }
        }
      }
    },
    "model.list": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "type": "object",
          "required": [
            "provider"
          ],
          "properties": {
            "provider": {
              "$ref": "#/$defs/Identity"
            }
          }
        },
        "result": {
          "type": "object",
          "required": [
            "provider",
            "models"
          ],
          "properties": {
            "provider": {
              "type": "string"
            },
            "models": {
              "$ref": "#/$defs/Objects"
            }
