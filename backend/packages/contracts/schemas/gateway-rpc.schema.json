  "properties": {
    "mcp.elicitation.respond": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "$ref": "mcp-elicitation.schema.json#/$defs/response"
        },
        "result": {
          "type": "object",
          "required": [
            "accepted"
          ],
          "properties": {
            "accepted": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "initialize": {
      "$ref": "#/$defs/BootstrapMethod"
    },
    "status.get": {
      "$ref": "#/$defs/StatusMethod"
    },
    "status.inspect": {
      "$ref": "#/$defs/StatusMethod"
    },
    "session.bootstrap": {
      "$ref": "#/$defs/BootstrapMethod"
    },
    "session.list": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "$ref": "#/$defs/SessionQuery"
        },
        "result": {
          "type": "object",
          "required": [
            "sessions"
          ],
          "properties": {
            "sessions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SessionSummary"
              }
            }
          }
        }
      }
    },
    "session.new": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "$ref": "#/$defs/EmptyParams"
        },
        "result": {
          "$ref": "#/$defs/SessionTransition"
        }
      }
    },
    "session.resume": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "$ref": "#/$defs/ResumeParams"
        },
        "result": {
          "$ref": "#/$defs/SessionTransition"
        }
      }
    },
    "session.resume.preview": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "type": "object",
          "required": [
            "session_id"
          ],
          "properties": {
            "session_id": {
              "$ref": "#/$defs/Identity"
            }
          }
        },
        "result": {
          "$ref": "#/$defs/ResumePreview"
        }
      }
    },
    "session.tree": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "session_id": {
              "$ref": "#/$defs/Identity"
            },
            "limit": {
              "type": "integer"
            }
          }
        },
        "result": {
          "type": "object",
          "required": [
            "session_id",
            "active_path",
            "nodes"
          ],
          "properties": {
            "session_id": {
              "type": "string"
            },
            "active_path": {
              "$ref": "#/$defs/Strings"
            },
            "nodes": {
              "$ref": "#/$defs/Objects"
            }
          }
        }
      }
    },
    "transcript.load": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "$ref": "#/$defs/TranscriptParams"
        },
        "result": {
          "$ref": "#/$defs/TranscriptPage"
        }
      }
    },
    "provider.attempts.load": {
      "type": "object",
      "required": ["params", "result"],
      "properties": {
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "session_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "turn_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "after_sequence": {"type": "integer", "minimum": 0, "maximum": 1000},
            "before_event_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "limit": {"type": "integer", "minimum": 1, "maximum": 500}
          },
          "dependentRequired": {"after_sequence": ["request_id"]},
          "not": {"required": ["before_event_id", "request_id"]}
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_id", "records", "has_more"],
          "properties": {
            "session_id": {"type": "string"},
            "records": {"type": "array", "maxItems": 500, "items": {"$ref": "provider-attempt.schema.json#/$defs/record"}},
            "has_more": {"type": "boolean"},
            "next_before_event_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
          }
        }
      }
    },
    "turn.submit": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
