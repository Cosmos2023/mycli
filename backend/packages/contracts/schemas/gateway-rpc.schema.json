        },
        "result": {
          "$ref": "#/$defs/Permissions"
        }
      }
    },
    "permissions.update": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "type": "object",
          "required": [
            "profile"
          ],
          "properties": {
            "profile": {
              "$ref": "#/$defs/Permission"
            }
          }
        },
        "result": {
          "type": "object",
          "required": [
            "permissions",
            "status"
          ],
          "properties": {
            "permissions": {
              "$ref": "#/$defs/Permissions"
            },
            "status": {
              "$ref": "#/$defs/Status"
            }
          }
        }
      }
    },
    "provider.list": {
      "type": "object",
      "required": [
        "params",
