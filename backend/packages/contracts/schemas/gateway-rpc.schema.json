            "accepted": {
              "type": "boolean"
            },
            "requested": {
              "type": "boolean"
            },
            "admission_cancelled": {
              "type": "boolean"
            },
            "client_user_message_id": {
              "type": "string"
            },
            "turn_id": {
              "type": "string"
            },
            "client_turn_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "turn.queue.pop": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "$ref": "#/$defs/OwnerParams"
        },
        "result": {
          "$ref": "#/$defs/QueueResult"
        }
      }
    },
    "turn.queue.clear": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "$ref": "#/$defs/RestoreParams"
        },
        "result": {
          "$ref": "#/$defs/QueueResult"
        }
      }
    },
    "turn.queue.restore.ack": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "allOf": [
            {
              "$ref": "#/$defs/RestoreParams"
            },
            {
              "type": "object",
              "required": [
                "restore_token"
              ],
              "properties": {
                "restore_token": { "$ref": "#/$defs/Identity" }
              }
            }
          ]
        },
        "result": {
          "$ref": "#/$defs/QueueResult"
        }
      }
    },
    "turn.queue.migration.ack": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "type": "object",
          "required": [
            "token"
          ],
          "properties": {
            "token": {
              "$ref": "#/$defs/Identity"
            }
          }
        },
        "result": {
          "$ref": "#/$defs/QueueResult"
        }
      }
    },
    "approval.respond": {
      "$ref": "#/$defs/ApprovalMethod"
    },
    "decision.resolve": {
      "$ref": "#/$defs/ApprovalMethod"
    },
    "clarify.respond": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "$ref": "#/$defs/ClarificationParams"
        },
        "result": {
          "$ref": "#/$defs/TurnAccepted"
        }
      }
    },
    "workspace.trust.status": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "$ref": "#/$defs/EmptyParams"
        },
        "result": {
          "$ref": "#/$defs/TrustState"
        }
      }
    },
    "workspace.trust.set": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "$ref": "#/$defs/Trust"
            }
          }
        },
        "result": {
          "$ref": "#/$defs/TrustState"
        }
      }
    },
    "permissions.list": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
