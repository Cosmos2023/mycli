      ],
      "properties": {
        "params": {
          "$ref": "#/$defs/EmptyParams"
        },
        "result": {
          "type": "object",
          "required": [
            "ok"
          ],
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "message": {
              "type": "string"
            }
          }
