{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycli.local/contracts/gateway-rpc.schema.json",
  "title": "GatewayRpcMethods",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "initialize",
    "status.get",
    "status.inspect",
    "session.bootstrap",
    "session.list",
    "session.new",
    "session.resume",
    "session.resume.preview",
    "session.tree",
    "transcript.load",
    "provider.attempts.load",
    "turn.submit",
    "turn.steer",
    "turn.follow_up",
    "turn.interrupt",
    "turn.queue.pop",
    "turn.queue.clear",
    "turn.queue.restore.ack",
    "turn.queue.migration.ack",
    "approval.respond",
    "decision.resolve",
    "clarify.respond",
    "mcp.elicitation.respond",
    "workspace.trust.status",
    "workspace.trust.set",
    "permissions.list",
    "permissions.update",
    "provider.list",
    "model.list",
    "model.select",
    "auth.api_key.save",
    "provider.connectivity.validate",
    "settings.load",
    "settings.save",
    "settings.keymap.reset",
    "update.status",
    "update.dismiss",
    "command.list",
    "command.run",
    "completion.slash",
    "completion.path",
    "resource.list",
    "extension.manifest",
    "shell.list",
    "shell.output.load",
    "shell.stop",
    "shell.stop_all",
    "trace.export",
    "shutdown"
