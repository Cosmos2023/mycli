            "provider",
            "models",
            "status"
          ],
          "properties": {
            "selected": {
              "type": "object"
            },
            "auth_providers": {
              "$ref": "#/$defs/Objects"
            },
            "provider": {
              "type": "string"
            },
            "models": {
              "$ref": "#/$defs/Objects"
            },
            "status": {
              "$ref": "#/$defs/Status"
            },
            "scope": {
              "type": "string"
            }
          }
        }
      }
    },
    "auth.api_key.save": {
      "type": "object",
      "required": [
        "params",
        "result"
      ],
      "properties": {
        "params": {
          "type": "object",
          "required": [
            "provider_id",
            "api_key"
          ],
          "properties": {
            "provider_id": {
              "$ref": "#/$defs/Identity"
            },
            "api_key": {
              "type": "string",
              "minLength": 1
            },
            "auth_ref": {
              "$ref": "#/$defs/Identity"
            }
          }
        },
        "result": {
          "type": "object",
          "properties": {
            "provider_id": {
              "type": "string"
            },
            "auth_ref": {
              "type": "string"
            },
            "auth_providers": {
              "$ref": "#/$defs/Objects"
            },
            "auth_status": {
              "type": "object"
            }
          }
        }
      }
    },
    "provider.connectivity.validate": {
      "type": "object",
      "required": [
        "params",
