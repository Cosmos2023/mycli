{
  "name": "mycli-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend/apps/*",
    "backend/packages/*",
    "tui/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "npm run build --workspace @mycli/contracts && npm run build --workspace @mycli/gateway && npm run build --workspace @mycli/core && npm run build --workspace @mycli/config && npm run build --workspace @mycli/tools && npm run build --workspace @mycli/providers && npm run build --workspace @mycli/storage && npm run build --workspace @mycli/integrations && npm run build --workspace @mycli/runtime && npm run build --workspace mycli-shell-tui && npm run build --workspace @cosmos2023/mycli",
    "contracts:generate": "npm run generate --workspace @mycli/contracts",
    "contracts:check": "npm run check --workspace @mycli/contracts",
    "config:generate": "node --conditions=mycli-source --import tsx scripts/generate-config-reference.mjs",
    "config:check": "node --conditions=mycli-source --import tsx scripts/generate-config-reference.mjs --check",
    "dev": "node --conditions=mycli-source --import tsx backend/apps/mycli/src/cli.ts",
    "eval:coding": "node scripts/run-coding-evaluation.mjs",
    "eval:prompt": "node --conditions=mycli-source --import tsx scripts/run-system-prompt-evaluation.mjs",
    "lint": "eslint \"backend/apps/**/*.ts\" \"backend/packages/**/*.ts\"",
    "mycli": "node backend/apps/mycli/dist/cli.js",
    "pretest": "npm run build",
    "smoke:package": "node scripts/smoke_packed_cli.mjs",
		"sandbox:check-host": "node scripts/check-windows-sandbox-host.mjs",
		"promote:windows-sandbox-helper": "node scripts/promote-windows-sandbox-helper.mjs",
    "smoke:providers": "node --conditions=mycli-source --import tsx scripts/smoke_curated_providers.mjs",
    "smoke:providers:native": "node --conditions=mycli-source --import tsx scripts/smoke_native_providers.mjs",
    "smoke:release-compatibility": "node scripts/smoke_release_compatibility.mjs",
    "release:version": "node scripts/set-release-version.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:compatibility": "node --conditions=mycli-source --import tsx scripts/verify-release-compatibility.mjs",
    "prerelease:dry-run": "npm run build",
    "release:dry-run": "node scripts/publish-release.mjs --dry-run",
    "prerelease:publish": "npm run build",
    "release:publish": "node scripts/publish-release.mjs --publish",
    "smoke:tui-pty": "npm run build --workspace @mycli/tools && node scripts/smoke_tui_pty.mjs",
    "test": "node scripts/run-test-suite.mjs --suite ci",
    "test:ci": "npm test",
    "test:unit": "node scripts/run-test-suite.mjs --suite unit",
    "test:contract": "node scripts/run-test-suite.mjs --suite contract",
    "test:integration": "node scripts/run-test-suite.mjs --suite integration",
    "test:platform": "node scripts/run-test-suite.mjs --suite platform",
    "test:windows-sandbox": "node scripts/run-windows-sandbox-tests.mjs",
    "test:release": "node scripts/run-test-suite.mjs --suite release",
    "test:list": "node scripts/run-test-suite.mjs --list",
    "pretest:smoke": "npm run build",
    "test:smoke": "npm run smoke:m8 && npm run smoke:package",
    "test:smoke:live": "npm run smoke:providers --",
    "test:ux-contracts": "npm run config:check && node --import tsx --test backend/apps/mycli/test/ux-contract-baseline.test.ts",
    "test:m2": "npm run build && node --import tsx --test backend/apps/mycli/test/node-backend.integration.test.ts backend/apps/mycli/test/m2-smoke-runner.integration.test.ts",
    "test:m3": "npm run build && node --import tsx --test backend/apps/mycli/test/m3-read-turn.integration.test.ts",
    "test:m4": "npm run build && node --import tsx --test backend/apps/mycli/test/m4-file-mutation.integration.test.ts",
    "test:m5": "npm run build && node --import tsx --test backend/apps/mycli/test/m5-state-recovery.integration.test.ts",
    "test:m6": "npm run build && node --import tsx --test backend/apps/mycli/test/m6-persistent-shell.integration.test.ts",
    "test:m7": "npm run build && node --import tsx --test backend/apps/mycli/test/m7-extensions.integration.test.ts",
    "test:m8": "npm run build && node --import tsx --test backend/apps/mycli/test/node-runtime-m8-capability-audit.test.ts backend/apps/mycli/test/cli.test.ts",
    "smoke:m3": "node scripts/smoke_node_m3_read.mjs --protocol responses",
    "smoke:m4": "node scripts/smoke_node_m4_mutation.mjs --protocol responses",
    "smoke:m5": "node scripts/smoke_node_m5_state.mjs --protocol responses",
    "smoke:m6": "node scripts/smoke_node_m6_shell.mjs --protocol responses",
    "smoke:m7": "node scripts/smoke_node_m7_extensions.mjs --protocol responses",
    "smoke:m8": "node scripts/smoke_node_m8.mjs",
    "smoke:agents": "node scripts/smoke_node_agents.mjs --protocol responses",
    "smoke:agents-foreground": "node scripts/smoke_node_agent_foreground.mjs",
    "benchmark:agent-workers": "node --conditions=mycli-source --import tsx --expose-gc scripts/benchmark_agent_workers.mjs",
    "benchmark:long-history": "node --conditions=mycli-source --import tsx --expose-gc scripts/benchmark_long_history_resume.mjs",
    "benchmark:transcript-normalization": "node --conditions=mycli-source --import tsx scripts/benchmark_transcript_normalization.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.13.2",
    "eslint": "^9.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@cosmos2023/mycli": "^0.1.1",
    "@mycli/config": "^0.1.1",
    "@mycli/contracts": "^0.1.1",
    "@mycli/core": "^0.1.1",
    "@mycli/gateway": "^0.1.1",
    "@mycli/integrations": "^0.1.1",
    "@mycli/providers": "^0.1.1",
    "@mycli/runtime": "^0.1.1",
    "@mycli/storage": "^0.1.1",
    "@mycli/tools": "^0.1.1",
    "mycli-shell-tui": "^0.1.1"
  }
}
